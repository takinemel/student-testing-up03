<Window x:Class="TestingStudents.AdminTestsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Управление тестами | Тестирование студентов"
        Height="750"
        Width="1200"
        Style="{StaticResource AppWindowStyle}"
        Loaded="Window_Loaded"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- ЗАГОЛОВОК -->
        <StackPanel Grid.Row="0"
                    Margin="0,0,0,20">
            <TextBlock Text="Управление тестами"
                       Style="{StaticResource H1Style}"/>
            <TextBlock Text="Создание тестов вручную или импорт из JSON-файла"
                       Style="{StaticResource CaptionStyle}"/>
        </StackPanel>
        <!-- ТАБЛИЦА -->
        <Border Grid.Row="1"
                Style="{StaticResource CardStyle}"
                Padding="0">
            <DataGrid Name="dgTests"
                      Style="{StaticResource AppDataGridStyle}"
                      SelectionChanged="dgTests_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID"
                                        Binding="{Binding IDTest}"
                                        Width="60"/>
                    <DataGridTextColumn Header="Название теста"
                                        Binding="{Binding Nazvanie}"
                                        Width="200"/>
                    <DataGridTextColumn Header="Дисциплина"
                                        Binding="{Binding NazvaniePredmeta}"
                                        Width="200"/>
                    <DataGridTextColumn Header="Описание"
                                        Binding="{Binding Opisanie}"
                                        Width="*"/>
                    <DataGridTextColumn Header="Время (мин)"
                                        Binding="{Binding Vremya_vipolneniya}"
                                        Width="110"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
        <!-- ФОРМА -->
        <Border Grid.Row="2"
                Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <!-- ПОЛЯ -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <!-- ID -->
                        <ColumnDefinition Width="70"/>
                        <!-- Название -->
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="12"/>
                        <!-- Дисциплина -->
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="12"/>
                        <!-- Описание -->
                        <ColumnDefinition Width="1.7*"/>
                        <ColumnDefinition Width="12"/>
                        <!-- Время -->
                        <ColumnDefinition Width="110"/>
                    </Grid.ColumnDefinitions>
                    <!-- ID -->
                    <StackPanel Grid.Column="0"
                                Margin="0,0,8,0">
                        <TextBlock Text="ID"
                                   Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Name="IDTestTextBox"
                                 Style="{StaticResource AppTextBoxStyle}"
                                 IsReadOnly="True"
                                 Background="#F1F3F5"
                                 Foreground="#212529"
                                 FontSize="14"
                                 Padding="8,0"
                                 Height="32"
                                 VerticalContentAlignment="Center"
                                 IsTabStop="False"/>
                    </StackPanel>
                    <!-- НАЗВАНИЕ ТЕСТА -->
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Название теста"
                                   Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Name="TestNazvanieTextBox"
                                 Style="{StaticResource AppTextBoxStyle}"
                                 Background="White"
                                 Foreground="#212529"
                                 FontSize="14"
                                 Padding="8,0"
                                 Height="32"
                                 VerticalContentAlignment="Center"
                                 CaretBrush="#212529"
                                 TextWrapping="NoWrap"/>
                    </StackPanel>
                    <!-- ДИСЦИПЛИНА -->
                    <StackPanel Grid.Column="3">
                        <TextBlock Text="Дисциплина"
                                   Style="{StaticResource FieldLabelStyle}"/>
                        <ComboBox Name="PredmetComboBox"
                                  Style="{StaticResource AppComboBoxStyle}"
                                  DisplayMemberPath="Nazvanie"
                                  SelectedValuePath="IDPredmet"
                                  Height="32"
                                  FontSize="14"
                                  Foreground="#212529"
                                  Background="White"
                                  VerticalContentAlignment="Center"/>
                    </StackPanel>
                    <!-- ОПИСАНИЕ -->
                    <StackPanel Grid.Column="5">
                        <TextBlock Text="Описание"
                                   Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Name="TestOpisanieTextBox"
                                 Style="{StaticResource AppTextBoxStyle}"
                                 Background="White"
                                 Foreground="#212529"
                                 FontSize="14"
                                 Padding="8,0"
                                 Height="32"
                                 VerticalContentAlignment="Center"
                                 CaretBrush="#212529"
                                 TextWrapping="NoWrap"/>
                    </StackPanel>
                    <!-- ВРЕМЯ -->
                    <StackPanel Grid.Column="7">
                        <TextBlock Text="Время (мин)"
                                   Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Name="TestTimeTextBox"
                                 Style="{StaticResource AppTextBoxStyle}"
                                 Background="White"
                                 Foreground="#212529"
                                 FontSize="14"
                                 Padding="8,0"
                                 Height="32"
                                 VerticalContentAlignment="Center"
                                 CaretBrush="#212529"
                                 TextWrapping="NoWrap"/>
                    </StackPanel>
                </Grid>
                <!-- КНОПКИ -->
                <Grid Grid.Row="1"
                      Margin="0,16,0,0">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Left">
                        <Button Name="AddTestButton"
                                Content="Добавить тест"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Width="140"
                                Height="36"
                                Margin="0,0,8,0"
                                Click="AddTestButton_Click"/>
                        <Button Name="ChangeTestButton"
                                Content="Изменить"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Width="130"
                                Height="36"
                                Margin="0,0,8,0"
                                Click="ChangeTestButton_Click"/>
                        <Button Name="DeleteTestButton"
                                Content="Удалить"
                                Style="{StaticResource DangerButtonStyle}"
                                Width="130"
                                Height="36"
                                Margin="0,0,8,0"
                                Click="DeleteTestButton_Click"/>
                        <Button Name="ImportJsonButton"
                                Content="Импорт JSON"
                                Style="{StaticResource SuccessButtonStyle}"
                                Width="140"
                                Height="36"
                                Margin="0,0,8,0"
                                Click="ImportJsonButton_Click"/>
                    </StackPanel>
                    <Button Name="ExitButton"
                            Content="Выйти"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Width="130"
                            Height="36"
                            HorizontalAlignment="Right"
                            Click="ExitButton_Click"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>