<Window x:Class="TestingStudents.AddStudentToGroupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Зачисление студента в группу"
        Height="380" Width="500"
        Style="{StaticResource AppWindowStyle}"
        WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Зачисление студента в группу" Style="{StaticResource H2Style}" Margin="0,0,0,16"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="Группа" Style="{StaticResource FieldLabelStyle}"/>
            <ComboBox Name="GroupComboBox" Style="{StaticResource AppComboBoxStyle}" DisplayMemberPath="DisplayName" SelectedValuePath="IDGroup"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,12">
            <TextBlock Text="Студент" Style="{StaticResource FieldLabelStyle}"/>
            <ComboBox Name="StudentComboBox" Style="{StaticResource AppComboBoxStyle}" DisplayMemberPath="DisplayName" SelectedValuePath="IDUser"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Зачислить" Style="{StaticResource SuccessButtonStyle}" Width="140" Height="36" Margin="0,0,8,0" Click="EnrollButton_Click"/>
            <Button Content="Отмена" Style="{StaticResource SecondaryButtonStyle}" Width="120" Height="36" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>