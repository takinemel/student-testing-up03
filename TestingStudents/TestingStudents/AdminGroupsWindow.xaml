<Window x:Class="TestingStudents.AdminGroupsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Управление группами | Тестирование студентов"
        Height="650"
        Width="1000"
        Style="{StaticResource AppWindowStyle}"
        Loaded="Window_Loaded"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <StackPanel Grid.Row="0"
                    Margin="0,0,0,20">
            <TextBlock Text="Управление учебными группами"
                       Style="{StaticResource H1Style}"/>
            <TextBlock Text="Объединение студентов по направлениям и курсам"
                       Style="{StaticResource CaptionStyle}"/>
        </StackPanel>

        <!-- Таблица -->
        <Border Grid.Row="1"
                Style="{StaticResource CardStyle}"
                Padding="0">
            <DataGrid Name="dgGroups"
                      Style="{StaticResource AppDataGridStyle}"
                      SelectionChanged="dgGroups_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID"
                                        Binding="{Binding IDGroup}"
                                        Width="60"/>
                    <DataGridTextColumn Header="Название"
                                        Binding="{Binding Nazvanie}"
                                        Width="180"/>
                    <DataGridTextColumn Header="Курс"
                                        Binding="{Binding Kurs}"
                                        Width="100"/>
                    <DataGridTextColumn Header="Отделение / направление"
                                        Binding="{Binding NazvanieOtdeleniya}"
                                        Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Форма -->
        <Border Grid.Row="2"
                Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Поля -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="1.5*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ID -->
                    <StackPanel Grid.Column="0"
                                Margin="0,0,8,0">
                        <TextBlock Text="ID"
                                   Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Name="IDGroupTextBox"
                                 Style="{StaticResource AppTextBoxStyle}"
                                 IsReadOnly="True"
                                 Background="#F1F3F5"/>

                    </StackPanel>

                    <!-- Название -->
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Название группы"
                                   Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Name="NazvanieTextBox"
                                 Style="{StaticResource AppTextBoxStyle}"/>
                    </StackPanel>

                    <!-- Курс -->
                    <StackPanel Grid.Column="3">
                        <TextBlock Text="Курс обучения"
                           Style="{StaticResource FieldLabelStyle}"/>
                                    <ComboBox Name="KursComboBox"
                          Style="{StaticResource AppComboBoxStyle}"
                          Height="32"
                          FontSize="14"
                          Foreground="#212529"
                          Background="White"
                          VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <!-- Отделение -->
                    <StackPanel Grid.Column="5">
                        <TextBlock Text="Отделение"
                                   Style="{StaticResource FieldLabelStyle}"/>
                        <ComboBox Name="OtdelenieComboBox"
                            Style="{StaticResource AppComboBoxStyle}"
                            DisplayMemberPath="Otdelenie"
                            SelectedValuePath="IDOtdelenie"/>     
                    </StackPanel>
                </Grid>

                <!-- Кнопки -->
                <StackPanel Grid.Row="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,16,0,0">
                    <Button Name="AddButton"
                            Content="Добавить"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Width="130"
                            Margin="0,0,8,0"
                            Click="AddButton_Click"/>
                    <Button Name="ChangeButton"
                            Content="Изменить"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Width="130"
                            Margin="0,0,8,0"
                            Click="ChangeButton_Click"/>
                    <Button Name="EnrollStudentButton" 
                            Content="Зачислить студента" 
                            Style="{StaticResource SuccessButtonStyle}"
                            Width="180" Margin="0,0,8,0"
                            Click="EnrollStudentButton_Click"/>     
                    <Button Name="DeleteButton"
                            Content="Удалить"
                            Style="{StaticResource DangerButtonStyle}"
                            Width="130"
                            Margin="0,0,8,0"
                            Click="DeleteButton_Click"/>
                    <Button Name="ExitButton"
                            Content="Выйти"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Width="130"
                            Click="ExitButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>