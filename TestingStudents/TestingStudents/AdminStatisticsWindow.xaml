<Window x:Class="TestingStudents.AdminStatisticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Статистика | Тестирование студентов"
        Height="780" Width="1280"
        Style="{StaticResource AppWindowStyle}"
        Loaded="Window_Loaded"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Статистика и отчёты" Style="{StaticResource H1Style}"/>
            <TextBlock Text="Анализ успеваемости по дисциплинам, группам и студентам"
                       Style="{StaticResource CaptionStyle}"/>
        </StackPanel>

        <!-- Переключатели вкладок -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
            <Button Name="ByPredmetTabButton" Content="По дисциплинам"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Width="180" Margin="0,0,8,0"
                    Click="ByPredmetTabButton_Click"/>
            <Button Name="ByGroupTabButton" Content="По группам"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Width="180" Margin="0,0,8,0"
                    Click="ByGroupTabButton_Click"/>
            <Button Name="ByStudentTabButton" Content="По студентам"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Width="180"
                    Click="ByStudentTabButton_Click"/>
        </StackPanel>

        <!-- Область контента -->
        <Grid Grid.Row="2">

            <!--  ВКЛАДКА: ПО ДИСЦИПЛИНАМ  -->
            <Grid Name="ByPredmetPanel" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Сводные карточки -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="16">
                        <StackPanel>
                            <TextBlock Text="Всего дисциплин" Style="{StaticResource CaptionStyle}"/>
                            <TextBlock Name="TotalPredmetsTextBlock" Text="0"
                                       FontSize="28" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBrush}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="16">
                        <StackPanel>
                            <TextBlock Text="Всего тестов" Style="{StaticResource CaptionStyle}"/>
                            <TextBlock Name="TotalTestsTextBlock" Text="0"
                                       FontSize="28" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBrush}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4" Style="{StaticResource CardStyle}" Padding="16">
                        <StackPanel>
                            <TextBlock Text="Средний процент по системе"
                                       Style="{StaticResource CaptionStyle}"/>
                            <TextBlock Name="OverallAvgTextBlock" Text="—"
                                       FontSize="28" FontWeight="SemiBold"
                                       Foreground="{StaticResource SuccessBrush}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Таблица + диаграмма -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="0">
                        <DataGrid Name="dgPredmets"
                                  Style="{StaticResource AppDataGridStyle}"
                                  AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Дисциплина"
                                                    Binding="{Binding Nazvanie}" Width="*"/>
                                <DataGridTextColumn Header="Тестов"
                                                    Binding="{Binding TestCount}" Width="90"/>
                                <DataGridTextColumn Header="Прошли"
                                                    Binding="{Binding AttemptsCount}" Width="90"/>
                                <DataGridTextColumn Header="Средний %"
                                                    Binding="{Binding AvgPercent, StringFormat={}{0:F1}%}"
                                                    Width="110"/>
                                <DataGridTextColumn Header="Сдали"
                                                    Binding="{Binding PassedCount}" Width="90"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Средний процент по дисциплинам"
                                       Style="{StaticResource SubtitleStyle}"
                                       Margin="0,0,0,12"/>
                            <ItemsControl Name="PredmetChartItems">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="180"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="70"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Nazvanie}"
                                                       Style="{StaticResource CaptionStyle}"
                                                       TextTrimming="CharacterEllipsis"/>

                                            <Border Grid.Column="1"
                                                    Height="20"
                                                    Background="#E9ECEF"
                                                    CornerRadius="4"
                                                    Margin="8,0">
                                                <Border HorizontalAlignment="Left"
                                                        Background="{StaticResource AccentBrush}"
                                                        CornerRadius="4"
                                                        Width="{Binding BarWidth}"/>
                                            </Border>

                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding AvgPercent, StringFormat={}{0:F1}%}"
                                                       Style="{StaticResource BodyStyle}"
                                                       HorizontalAlignment="Right"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!--  ВКЛАДКА: ПО ГРУППАМ  -->
            <Grid Name="ByGroupPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="16">
                        <StackPanel>
                            <TextBlock Text="Всего групп" Style="{StaticResource CaptionStyle}"/>
                            <TextBlock Name="TotalGroupsTextBlock" Text="0"
                                       FontSize="28" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBrush}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="16">
                        <StackPanel>
                            <TextBlock Text="Всего студентов" Style="{StaticResource CaptionStyle}"/>
                            <TextBlock Name="TotalStudentsTextBlock" Text="0"
                                       FontSize="28" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBrush}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4" Style="{StaticResource CardStyle}" Padding="16">
                        <StackPanel>
                            <TextBlock Text="Средний балл по системе"
                                       Style="{StaticResource CaptionStyle}"/>
                            <TextBlock Name="OverallAvgBalliTextBlock" Text="—"
                                       FontSize="28" FontWeight="SemiBold"
                                       Foreground="{StaticResource SuccessBrush}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="0">
                        <DataGrid Name="dgGroupsStats"
                                  Style="{StaticResource AppDataGridStyle}"
                                  AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Группа"
                                                    Binding="{Binding Nazvanie}" Width="*"/>
                                <DataGridTextColumn Header="Курс"
                                                    Binding="{Binding Kurs}" Width="70"/>
                                <DataGridTextColumn Header="Студентов"
                                                    Binding="{Binding StudentCount}" Width="100"/>
                                <DataGridTextColumn Header="Прошли тесты"
                                                    Binding="{Binding CompletedCount}" Width="120"/>
                                <DataGridTextColumn Header="Средний балл"
                                                    Binding="{Binding AvgBalli, StringFormat={}{0:F1}}"
                                                    Width="120"/>
                                <DataGridTextColumn Header="Сдали"
                                                    Binding="{Binding PassedCount}" Width="80"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Средний балл по группам"
                                       Style="{StaticResource SubtitleStyle}"
                                       Margin="0,0,0,12"/>
                            <ItemsControl Name="GroupChartItems">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="60"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Nazvanie}"
                                                       Style="{StaticResource CaptionStyle}"
                                                       TextTrimming="CharacterEllipsis"/>

                                            <Border Grid.Column="1"
                                                    Height="20"
                                                    Background="#E9ECEF"
                                                    CornerRadius="4"
                                                    Margin="8,0">
                                                <Border HorizontalAlignment="Left"
                                                        Background="{StaticResource SuccessBrush}"
                                                        CornerRadius="4"
                                                        Width="{Binding BarWidth}"/>
                                            </Border>

                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding AvgBalli, StringFormat={}{0:F1}}"
                                                       Style="{StaticResource BodyStyle}"
                                                       HorizontalAlignment="Right"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!--  ВКЛАДКА: ПО СТУДЕНТАМ  -->
            <Grid Name="ByStudentPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Фильтры -->
                <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Группа" Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox Name="FilterGroupComboBox"
                                      Style="{StaticResource AppComboBoxStyle}"
                                      DisplayMemberPath="Nazvanie"
                                      SelectedValuePath="IDGroup"
                                      SelectionChanged="FilterGroupComboBox_SelectionChanged"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Дисциплина" Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox Name="FilterPredmetComboBox"
                                      Style="{StaticResource AppComboBoxStyle}"
                                      DisplayMemberPath="Nazvanie"
                                      SelectedValuePath="IDPredmet"
                                      SelectionChanged="FilterPredmetComboBox_SelectionChanged"/>
                        </StackPanel>

                        <Button Grid.Column="5"
                                Content="Сбросить фильтры"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Width="180" Height="32"
                                VerticalAlignment="Bottom"
                                Click="ResetFiltersButton_Click"/>
                    </Grid>
                </Border>

                <!-- Таблица результатов -->
                <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="0">
                    <DataGrid Name="dgStudentsStats"
                              Style="{StaticResource AppDataGridStyle}"
                              AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Студент"
                                                Binding="{Binding FIO}" Width="*"/>
                            <DataGridTextColumn Header="Группа"
                                                Binding="{Binding GroupNazvanie}" Width="130"/>
                            <DataGridTextColumn Header="Дисциплина"
                                                Binding="{Binding PredmetNazvanie}" Width="180"/>
                            <DataGridTextColumn Header="Тест"
                                                Binding="{Binding TestNazvanie}" Width="200"/>
                            <DataGridTextColumn Header="Баллы"
                                                Binding="{Binding Balli}" Width="80"/>
                            <DataGridTextColumn Header="Процент"
                                                Binding="{Binding Procent, StringFormat={}{0:F1}%}"
                                                Width="90"/>
                            <DataGridTextColumn Header="Оценка"
                                                Binding="{Binding Ocenka}" Width="90"/>
                            <DataGridTextColumn Header="Дата"
                                                Binding="{Binding DataProhozhdeniya, StringFormat=dd.MM.yyyy}"
                                                Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>
        </Grid>

        <!-- нижняя панель с кнопками экспорта -->
        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Name="ExportPdfButton" Content="📄 Экспорт в PDF"
                        Style="{StaticResource SuccessButtonStyle}"
                        Width="180" Height="36" Margin="0,0,8,0"
                        Click="ExportPdfButton_Click"/>
                <Button Name="PrintButton" Content="🖨 Печать"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Width="140" Height="36" Margin="0,0,8,0"
                        Click="PrintButton_Click"/>
                <Button Name="ExitButton" Content="Выйти"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Width="130" Height="36"
                        Click="ExitButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>