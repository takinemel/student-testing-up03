<Window x:Class="TestingStudents.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TestingStudents"
        mc:Ignorable="d"
        Title="Авторизация | Тестирование студентов"
        Height="520"
        Width="450"
        Style="{StaticResource AppWindowStyle}"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid Margin="30">
        <Border Style="{StaticResource CardStyle}"
                Padding="30"
                VerticalAlignment="Center">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <!-- Заголовок -->
                <StackPanel Grid.Row="0"
                            Margin="0,0,0,28">
                    <TextBlock Text="Авторизация"
                               Style="{StaticResource H1Style}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Войдите в систему тестирования студентов"
                               Style="{StaticResource CaptionStyle}"
                               TextAlignment="Center"
                               Margin="0,6,0,0"/>
                </StackPanel>
                <!-- Логин -->
                <StackPanel Grid.Row="1"
                            Margin="0,0,0,16">
                    <TextBlock Text="Логин"
                               Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox Name="LoginTextBox"
                             Style="{StaticResource AppTextBoxStyle}"
                             Height="38"/>
                </StackPanel>
                <!-- Пароль -->
                <StackPanel Grid.Row="2"
                            Margin="0,0,0,24">
                    <TextBlock Text="Пароль"
                               Style="{StaticResource FieldLabelStyle}"/>
                    <PasswordBox Name="PasswordBox"
                         Height="38"
                         Padding="10,6"
                         FontSize="14"
                         FontFamily="Segoe UI"
                         HorizontalContentAlignment="Left"
                         VerticalContentAlignment="Center"/>
                </StackPanel>
                <!-- Кнопка авторизации -->
                <Button Grid.Row="3"
                        Name="LoginButton"
                        Content="Авторизоваться"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Height="42"
                        HorizontalAlignment="Stretch"
                        Click="LoginButton_Click"/>
                <!-- Разделитель -->
                <Border Grid.Row="4"
                        Height="1"
                        Background="#E5E7EB"
                        Margin="0,24,0,16"/>
            </Grid>
        </Border>
    </Grid>
</Window>